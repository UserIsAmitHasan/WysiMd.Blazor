@using WysiMd.Blazor.Models
@namespace WysiMd.Blazor.Components

<div class="wysimd-toolbar">
    @foreach (var item in EnabledItems)
    {
        if (item == "|")
        {
            <div class="wysimd-separator"></div>
        }
        else if (item == "heading")
        {
            if (!IsHidden("heading"))
            {
                <div class="wysimd-toolbar-group" data-tooltip="Heading Level" title="Heading Level">
                    <select class="wysimd-heading-select"
                            value="@_headingSelectValue"
                            @onchange="OnHeadingChange"
                            disabled="@ReadOnly">
                        <option value="0">¶</option>
                        <option value="1">H1</option>
                        <option value="2">H2</option>
                        <option value="3">H3</option>
                        <option value="4">H4</option>
                        <option value="5">H5</option>
                        <option value="6">H6</option>
                    </select>
                </div>
            }
        }
        else if (item == "mode-toggle")
        {
            if (!IsHidden("mode-toggle"))
            {
                <button type="button" class="wysimd-toolbar-btn @(Mode == EditorMode.Raw ? "active" : "")"
                        data-action="mode-toggle" data-tooltip="Visual / Raw" title="Visual / Raw"
                        @onclick="async () => await ModeChanged.InvokeAsync(Mode == EditorMode.Raw ? EditorMode.Visual : EditorMode.Raw)">
                    @RawIcon
                </button>
            }
        }
        else if (item == "theme-toggle")
        {
            if (!IsHidden("theme-toggle"))
            {
                <button type="button" class="wysimd-toolbar-btn"
                        data-action="theme-toggle" data-tooltip="Toggle theme" title="Toggle theme"
                        @onclick="async () => await ThemeChanged.InvokeAsync()">
                    @(IsDarkTheme ? SunIcon : MoonIcon)
                </button>
            }
        }
        else if (item == "overflow-toggle")
        {
            if (!IsHidden("overflow-toggle"))
            {
                <button type="button" class="wysimd-toolbar-btn @(_showOverflow ? "active" : "")"
                        data-action="overflow-toggle" data-tooltip="More" title="More"
                        @onclick="ToggleOverflow">
                    @MoreIcon
                </button>
            }
        }
        else if (_buttons.TryGetValue(item, out var btn) && !IsHidden(item))
        {
            var (icon, tip, shortcut) = ResolveItem(item, btn);
            string fullTip = tip + (shortcut != null ? $" ({shortcut})" : "");
            bool isActive = ActiveFormats.Contains(item);
            bool isEditAction = IsEditAction(item);
            <button type="button"
                    class="wysimd-toolbar-btn @(isActive ? "active" : "") @(ReadOnly && isEditAction ? "wysimd-disabled" : "")"
                    data-action="@item" data-tooltip="@fullTip" title="@fullTip"
                    disabled="@(ReadOnly && isEditAction)"
                    @onclick="() => ActionTriggered.InvokeAsync(item)"
                    @onmousedown:preventDefault>
                @((MarkupString)icon)
            </button>
        }
    }
</div>

@if (_showOverflow && OverflowItems.Count > 0)
{
    <div class="wysimd-toolbar wysimd-toolbar-overflow">
        @if (AllowFileNameEditing)
        {
            <div class="wysimd-filename-wrapper">
                <input class="wysimd-filename-input"
                       value="@FileName"
                       @oninput="OnFileNameInput"
                       placeholder="filename"
                       readonly="@ReadOnly" />
                <span class="wysimd-filename-ext">.md</span>
            </div>
            <div class="wysimd-separator"></div>
        }
        @foreach (var oi in OverflowItems)
        {
            if (oi == "|")
            {
                <div class="wysimd-separator"></div>
            }
            else if (_buttons.TryGetValue(oi, out var ob) && !IsHidden(oi))
            {
                var (icon, tip, _) = ResolveItem(oi, ob);
                bool isActive = ActiveFormats.Contains(oi);
                bool isEditAction = IsEditAction(oi);
                <button type="button"
                        class="wysimd-toolbar-btn @(isActive ? "active" : "") @(ReadOnly && isEditAction ? "wysimd-disabled" : "")"
                        data-action="@oi" title="@tip"
                        disabled="@(ReadOnly && isEditAction)"
                        @onclick="() => ActionTriggered.InvokeAsync(oi)"
                        @onmousedown:preventDefault>
                    @((MarkupString)icon)
                </button>
            }
        }
    </div>
}

@code {
    [Parameter] public List<string> EnabledItems { get; set; } = EditorOptions.DefaultToolbarItems;
    [Parameter] public List<string> OverflowItems { get; set; } = EditorOptions.DefaultOverflowItems;
    [Parameter] public EditorMode Mode { get; set; }
    [Parameter] public HashSet<string> ActiveFormats { get; set; } = [];
    [Parameter] public bool IsDarkTheme { get; set; }
    [Parameter] public string FileName { get; set; } = string.Empty;
    [Parameter] public bool AllowFileNameEditing { get; set; } = true;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public Dictionary<string, ToolbarItemOptions> ItemOverrides { get; set; } = [];
    [Parameter] public EventCallback<string> FileNameChanged { get; set; }
    [Parameter] public EventCallback<string> ActionTriggered { get; set; }
    [Parameter] public EventCallback<EditorMode> ModeChanged { get; set; }
    [Parameter] public EventCallback ThemeChanged { get; set; }
    [Parameter] public EventCallback<int> HeadingLevelChanged { get; set; }

    private bool _showOverflow;
    private string _headingSelectValue = "0";

    private void ToggleOverflow()
    {
        _showOverflow = !_showOverflow;
        StateHasChanged();
    }

    private async Task OnHeadingChange(ChangeEventArgs e)
    {
        if (!ReadOnly && int.TryParse(e.Value?.ToString(), out int level))
        {
            await HeadingLevelChanged.InvokeAsync(level);
        }

        // Reset so picking the same level again still fires change.
        _headingSelectValue = "0";
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnFileNameInput(ChangeEventArgs e)
    {
        await FileNameChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
    }

    private bool IsHidden(string id)
        => ItemOverrides.TryGetValue(id, out var o) && o.Hidden;

    // Returns (icon, tooltip, shortcut) with any overrides applied
    private (string icon, string tooltip, string? shortcut) ResolveItem(string id, ToolbarItem btn)
    {
        if (!ItemOverrides.TryGetValue(id, out var o))
            return (btn.Icon, btn.Tooltip, btn.KeyboardShortcut);
        return (
            o.Icon ?? btn.Icon,
            o.Tooltip ?? btn.Tooltip,
            o.KeyboardShortcut ?? btn.KeyboardShortcut
        );
    }

    // Actions that modify content — disabled in ReadOnly mode
    private static readonly HashSet<string> _editActions =
    [
        "bold", "italic", "strikethrough", "unordered-list", "ordered-list",
        "task-list", "link", "image", "code", "code-block", "blockquote",
        "horizontal-rule", "table", "insert-row", "delete-row", "insert-col",
        "delete-col", "auto-sum", "undo", "redo", "heading"
    ];

    private static bool IsEditAction(string id) => _editActions.Contains(id);

    private static readonly MarkupString RawIcon  = new("""<svg viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>""");
    private static readonly MarkupString SunIcon  = new("""<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>""");
    private static readonly MarkupString MoonIcon = new("""<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>""");
    private static readonly MarkupString MoreIcon = new("""<svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1.5" fill="currentColor" stroke="none"/></svg>""");

    private readonly Dictionary<string, ToolbarItem> _buttons = new()
    {
        ["undo"]           = new() { Tooltip = "Undo",               KeyboardShortcut = "Ctrl+Z", Icon = """<svg viewBox="0 0 24 24"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>""" },
        ["redo"]           = new() { Tooltip = "Redo",               KeyboardShortcut = "Ctrl+Y", Icon = """<svg viewBox="0 0 24 24"><path d="M21 7v6h-6"/><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7"/></svg>""" },
        ["bold"]           = new() { Tooltip = "Bold",               KeyboardShortcut = "Ctrl+B", Icon = """<svg viewBox="0 0 24 24"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>""" },
        ["italic"]         = new() { Tooltip = "Italic",             KeyboardShortcut = "Ctrl+I", Icon = """<svg viewBox="0 0 24 24"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg>""" },
        ["strikethrough"]  = new() { Tooltip = "Strikethrough",                                   Icon = """<svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><path d="M16 6C16 6 14.5 4 12 4s-5 1.5-5 4c0 5.5 10 3 10 8 0 2.5-2 4-5 4s-5-2-5-2"/></svg>""" },
        ["unordered-list"] = new() { Tooltip = "Bullet List",                                     Icon = """<svg viewBox="0 0 24 24"><line x1="9" y1="6" x2="20" y2="6"/><line x1="9" y1="12" x2="20" y2="12"/><line x1="9" y1="18" x2="20" y2="18"/><circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="18" r="1.5" fill="currentColor" stroke="none"/></svg>""" },
        ["ordered-list"]   = new() { Tooltip = "Numbered List",                                   Icon = """<svg viewBox="0 0 24 24"><line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/><path d="M4 6h1v4" stroke-width="1.5"/><path d="M4 10h2" stroke-width="1.5"/><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1" stroke-width="1.5"/></svg>""" },
        ["link"]           = new() { Tooltip = "Insert Link",        KeyboardShortcut = "Ctrl+L", Icon = """<svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>""" },
        ["image"]          = new() { Tooltip = "Upload Image",                                    Icon = """<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>""" },
        ["code"]           = new() { Tooltip = "Inline Code",        KeyboardShortcut = "Ctrl+`", Icon = """<svg viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>""" },
        ["code-block"]     = new() { Tooltip = "Code Block",                                      Icon = """<svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="18" rx="2"/><line x1="2" y1="9" x2="22" y2="9"/><polyline points="8 14 10 12 8 10"/><line x1="12" y1="14" x2="14" y2="14"/></svg>""" },
        ["blockquote"]     = new() { Tooltip = "Blockquote",                                      Icon = """<svg viewBox="0 0 24 24"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>""" },
        ["task-list"]      = new() { Tooltip = "Task List",                                       Icon = """<svg viewBox="0 0 24 24"><rect x="3" y="5" width="6" height="6" rx="1"/><polyline points="4 8 5.5 9.5 8 7"/><line x1="12" y1="8" x2="20" y2="8"/><rect x="3" y="14" width="6" height="6" rx="1"/><line x1="12" y1="17" x2="20" y2="17"/></svg>""" },
        ["horizontal-rule"]= new() { Tooltip = "Horizontal Rule",                                 Icon = """<svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12" stroke-width="2.5"/></svg>""" },
        ["table"]          = new() { Tooltip = "Insert Table",                                    Icon = """<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg>""" },
        ["insert-row"]     = new() { Tooltip = "Insert Row Below",                                Icon = """<svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="2" rx="1"/><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/><path d="M3 3h18v18H3z" fill="none" stroke="currentColor" opacity="0.2"/></svg>""" },
        ["delete-row"]     = new() { Tooltip = "Delete Row",                                      Icon = """<svg viewBox="0 0 24 24"><path d="M3 3h18v18H3z" fill="none" stroke="currentColor" opacity="0.2"/><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/><rect x="3" y="11" width="18" height="2" rx="1" fill="currentColor" stroke="none"/></svg>""" },
        ["insert-col"]     = new() { Tooltip = "Insert Column Right",                             Icon = """<svg viewBox="0 0 24 24"><rect x="11" y="3" width="2" height="18" rx="1"/><line x1="5" y1="12" x2="19" y2="12"/><line x1="12" y1="5" x2="12" y2="19"/><path d="M3 3h18v18H3z" fill="none" stroke="currentColor" opacity="0.2"/></svg>""" },
        ["delete-col"]     = new() { Tooltip = "Delete Column",                                   Icon = """<svg viewBox="0 0 24 24"><path d="M3 3h18v18H3z" fill="none" stroke="currentColor" opacity="0.2"/><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/><rect x="11" y="3" width="2" height="18" rx="1" fill="currentColor" stroke="none"/></svg>""" },
        ["auto-sum"]       = new() { Tooltip = "Auto Sum Column",                                 Icon = """<svg viewBox="0 0 24 24"><path d="M18 4H6l7 8-7 8h12" stroke-width="2.5"/></svg>""" },
        ["print"]          = new() { Tooltip = "Print",                                           Icon = """<svg viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>""" },
        ["download-pdf"]   = new() { Tooltip = "Download PDF",                                    Icon = """<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 18 15 15"/></svg>""" },
        ["download-md"]    = new() { Tooltip = "Download Markdown",                               Icon = """<svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>""" },
    };
}
