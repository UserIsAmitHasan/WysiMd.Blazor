@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
            OnClick="@(_ => drawerOpen = !drawerOpen)" />
        <MudText Typo="Typo.h6" Class="ml-3">WysiMd.Blazor + MudBlazor</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit"
            Href="https://github.com/autorior/WysiMd.Blazor" Target="_blank" />
        <MudToggleIconButton @bind-Toggled="isDark"
            Icon="@Icons.Material.Filled.DarkMode"
            ToggledIcon="@Icons.Material.Filled.LightMode"
            Color="Color.Inherit"
            Title="Toggle theme" />
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle1" Class="mt-2"><b>Demos</b></MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="/demo/basic" Icon="@Icons.Material.Filled.Edit">Basic Usage</MudNavLink>
            <MudNavLink Href="/demo/form" Icon="@Icons.Material.Filled.Assignment">Form Integration</MudNavLink>
            <MudNavLink Href="/demo/dialog" Icon="@Icons.Material.Filled.OpenInNew">In MudDialog</MudNavLink>
            <MudNavLink Href="/demo/card" Icon="@Icons.Material.Filled.Article">In MudCard</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-10">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerOpen = true;
    private bool isDark = false;
}
