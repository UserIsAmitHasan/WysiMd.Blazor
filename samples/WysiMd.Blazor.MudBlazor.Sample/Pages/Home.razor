@page "/"

<PageTitle>WysiMd.Blazor + MudBlazor</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">WysiMd.Blazor + MudBlazor</MudText>
<MudText Class="mb-6">
    This sample demonstrates WysiMd.Blazor integrated inside a MudBlazor application.
    Both libraries coexist without style conflicts — WysiMd.Blazor uses its own scoped
    CSS custom properties.
</MudText>

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Basic Usage</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>Drop <code>MarkdownEditor</code> anywhere in your MudBlazor page.</MudCardContent>
            <MudCardActions>
                <MudButton Href="/demo/basic" Variant="Variant.Text" Color="Color.Primary">View Demo</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Form Integration</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>Use inside <code>EditForm</code> with MudBlazor fields and validation.</MudCardContent>
            <MudCardActions>
                <MudButton Href="/demo/form" Variant="Variant.Text" Color="Color.Primary">View Demo</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">In MudDialog</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>Open an editor inside a MudDialog for modal editing workflows.</MudCardContent>
            <MudCardActions>
                <MudButton Href="/demo/dialog" Variant="Variant.Text" Color="Color.Primary">View Demo</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">In MudCard</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>Embed the editor in a card layout with MudBlazor action buttons.</MudCardContent>
            <MudCardActions>
                <MudButton Href="/demo/card" Variant="Variant.Text" Color="Color.Primary">View Demo</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>
