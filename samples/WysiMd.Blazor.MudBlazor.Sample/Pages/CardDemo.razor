@page "/demo/card"

<PageTitle>In MudCard — MudBlazor Sample</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Editor in a MudCard</MudText>
<MudText Class="mb-4">
    Embed the editor inside a <code>MudCard</code> with MudBlazor action buttons for a
    clean document-editing layout.
</MudText>

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudTextField @bind-Value="title" Label="Document Title" Variant="Variant.Text" />
        </CardHeaderContent>
        <CardHeaderActions>
            <MudChip T="string" Color="@(saved ? Color.Success : Color.Default)" Size="Size.Small">
                @(saved ? "Saved" : "Unsaved")
            </MudChip>
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent Style="padding:0">
        <MarkdownEditor @bind-Value="content"
            OnChange="OnChange"
            Options="@(new EditorOptions
            {
                ShowStatusBar = true,
                MinHeight = "360px",
                ToolbarItemOverrides = new Dictionary<string, ToolbarItemOptions>
                {
                    ["download"] = new ToolbarItemOptions { Hidden = true },
                }
            })" />
    </MudCardContent>

    <MudCardActions>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Preview"
            OnClick="TogglePreview" Variant="Variant.Text">
            @(showPreview ? "Hide Preview" : "Show Preview")
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Save"
            Color="Color.Primary" Variant="Variant.Filled"
            OnClick="Save">
            Save
        </MudButton>
    </MudCardActions>
</MudCard>

@if (showPreview)
{
    <MudCard Class="mt-4">
        <MudCardHeader>
            <CardHeaderContent><MudText Typo="Typo.subtitle1">Raw Markdown</MudText></CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;font-family:monospace">@content</MudText>
        </MudCardContent>
    </MudCard>
}

<MudExpansionPanels Class="mt-6">
    <MudExpansionPanel Text="View Source">
        <pre style="overflow-x:auto;font-size:0.82rem;line-height:1.5"><code>@SourceCode</code></pre>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private string title = "My Document";
    private string content = "# My Document\n\nStart writing your content here.\n\nThis editor is embedded inside a **MudCard** with Save / Preview actions.";
    private bool saved = true;
    private bool showPreview = false;

    private void OnChange(string _) => saved = false;
    private void Save() => saved = true;
    private void TogglePreview() => showPreview = !showPreview;

    private const string SourceCode =
        """
        @page "/demo/card"

        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudTextField @bind-Value="title" Label="Document Title" Variant="Variant.Text" />
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudChip T="string" Color="@(saved ? Color.Success : Color.Default)" Size="Size.Small">
                        @(saved ? "Saved" : "Unsaved")
                    </MudChip>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Style="padding:0">
                <MarkdownEditor @bind-Value="content"
                    OnChange="OnChange"
                    Options="@(new EditorOptions
                    {
                        ShowStatusBar = true,
                        MinHeight = "360px",
                        ToolbarItemOverrides = new Dictionary<string, ToolbarItemOptions>
                        {
                            ["download"] = new ToolbarItemOptions { Hidden = true },
                        }
                    })" />
            </MudCardContent>
            <MudCardActions>
                <MudSpacer />
                <MudButton StartIcon="@Icons.Material.Filled.Preview"
                    OnClick="TogglePreview" Variant="Variant.Text">Preview</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Save"
                    Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
            </MudCardActions>
        </MudCard>

        @code {
            private string title = "My Document";
            private string content = "# My Document\n\nStart writing...";
            private bool saved = true;
            private bool showPreview = false;

            private void OnChange(string _) => saved = false;
            private void Save() => saved = true;
            private void TogglePreview() => showPreview = !showPreview;
        }
        """;
}
