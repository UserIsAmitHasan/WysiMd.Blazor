@page "/demo/form"

<PageTitle>Form Integration — MudBlazor Sample</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Form Integration</MudText>
<MudText Class="mb-4">
    Use <code>MarkdownEditor</code> alongside MudBlazor form fields inside an <code>EditForm</code>.
</MudText>

<EditForm Model="model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <MudCard>
        <MudCardContent>
            <MudTextField @bind-Value="model.Title"
                Label="Title"
                Variant="Variant.Outlined"
                For="() => model.Title"
                Class="mb-4" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">Body (Markdown)</MudText>
            <MarkdownEditor @bind-Value="model.Body"
                Options="@(new EditorOptions { MinHeight = "280px", ShowStatusBar = true })" />
            <ValidationMessage For="() => model.Body" />
        </MudCardContent>
        <MudCardActions>
            <MudSpacer />
            <MudButton ButtonType="ButtonType.Reset" Variant="Variant.Text"
                OnClick="Reset">Reset</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                Color="Color.Primary">Publish</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@if (submitted)
{
    <MudAlert Severity="Severity.Success" Class="mt-4">
        <b>Published!</b> Title: @model.Title — @model.Body.Length chars
    </MudAlert>
}

<MudExpansionPanels Class="mt-6">
    <MudExpansionPanel Text="View Source">
        <pre style="overflow-x:auto;font-size:0.82rem;line-height:1.5"><code>@SourceCode</code></pre>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private PostModel model = new();
    private bool submitted;

    private void HandleSubmit() => submitted = true;

    private void Reset()
    {
        model = new();
        submitted = false;
    }

    private class PostModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Title is required")]
        [System.ComponentModel.DataAnnotations.StringLength(120)]
        public string Title { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Body is required")]
        [System.ComponentModel.DataAnnotations.MinLength(10, ErrorMessage = "Body must be at least 10 characters")]
        public string Body { get; set; } = string.Empty;
    }

    private const string SourceCode =
        """
        @page "/demo/form"

        <EditForm Model="model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <MudCard>
                <MudCardContent>
                    <MudTextField @bind-Value="model.Title" Label="Title" Variant="Variant.Outlined"
                        For="() => model.Title" Class="mb-4" />
                    <MarkdownEditor @bind-Value="model.Body"
                        Options="@(new EditorOptions { MinHeight = "280px", ShowStatusBar = true })" />
                    <ValidationMessage For="() => model.Body" />
                </MudCardContent>
                <MudCardActions>
                    <MudSpacer />
                    <MudButton ButtonType="ButtonType.Reset" OnClick="Reset">Reset</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary"
                        Variant="Variant.Filled">Publish</MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>

        @code {
            private PostModel model = new();
            private bool submitted;

            private void HandleSubmit() => submitted = true;
            private void Reset() { model = new(); submitted = false; }

            private class PostModel
            {
                [Required] [StringLength(120)] public string Title { get; set; } = string.Empty;
                [Required] [MinLength(10)] public string Body { get; set; } = string.Empty;
            }
        }
        """;
}
