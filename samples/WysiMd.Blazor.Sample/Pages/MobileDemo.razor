@page "/demo/mobile"

<PageTitle>Mobile View — WysiMd.Blazor</PageTitle>

<h1>Mobile View</h1>
<p>
    Resize the browser to 375 px wide (or use DevTools device emulation) to see the
    mobile-optimised layout: larger touch targets, horizontal scroll on the toolbar,
    and bottom-sheet dialogs.
</p>
<p>
    The editor below uses <code>OverflowItems</code> to keep the primary toolbar
    uncluttered on narrow screens.
</p>

<div class="demo-block">
    <div class="demo-block-header">Mobile-Optimised Toolbar</div>
    <MarkdownEditor @bind-Value="content"
        Options="@(new EditorOptions
        {
            EnabledToolbarItems = new List<string>
            {
                "bold", "italic", "heading", "link", "ul", "ol",
                "toggle-mode", "toggle-theme", "overflow"
            },
            OverflowItems = new List<string>
            {
                "strikethrough", "code", "code-block", "blockquote",
                "task", "table", "image", "hr",
                "insert-row", "delete-row", "insert-col", "delete-col",
                "auto-sum", "download", "print", "pdf"
            },
            MinHeight = "300px",
        })" />
</div>

<h2>Mobile Design Notes</h2>
<ul>
    <li>Toolbar buttons are <strong>48 × 48 px</strong> on mobile (≥ WCAG 2.5.5 minimum).</li>
    <li>The toolbar scrolls horizontally — no buttons are hidden by overflow at small widths.</li>
    <li>Link and Table dialogs appear as <strong>full-width bottom sheets</strong> on mobile.</li>
    <li>Set <code>Height = "calc(100dvh - 120px)"</code> for full-screen editing on mobile.</li>
</ul>

<details style="margin-top:2rem">
    <summary style="cursor:pointer;font-weight:600;padding:.5rem 0">View Source</summary>
    <pre style="overflow-x:auto;font-size:.82rem;line-height:1.5"><code>@SourceCode</code></pre>
</details>

@code {
    private string content = "# Mobile Demo\n\nThis editor is configured for mobile use.\n\nTry tapping the toolbar buttons and opening the **Link** or **Table** dialogs — they appear as bottom sheets on narrow screens.";

    private const string SourceCode =
        """
        @page "/demo/mobile"

        <MarkdownEditor @bind-Value="content"
            Options="@(new EditorOptions
            {
                EnabledToolbarItems = new List<string>
                {
                    "bold", "italic", "heading", "link", "ul", "ol",
                    "toggle-mode", "toggle-theme", "overflow"
                },
                OverflowItems = new List<string>
                {
                    "strikethrough", "code", "code-block", "blockquote",
                    "task", "table", "image", "hr", "download", "print", "pdf"
                },
                MinHeight = "300px",
            })" />

        @code {
            private string content = "# Mobile Demo";
        }
        """;
}
