<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Maintainer tool: regenerates the README demo GIF and screenshots in /assets.
    Deliberately NOT part of WysiMd.Blazor.sln so CI never builds or restores it.
    Run it explicitly from the repository root; see README.md in this folder.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WysiMd.Blazor.Capture</RootNamespace>
    <AssemblyName>WysiMd.Blazor.Capture</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep in sync with tests/WysiMd.Blazor.IntegrationTests so both use the same browser build. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.59.0" />
  </ItemGroup>

</Project>
